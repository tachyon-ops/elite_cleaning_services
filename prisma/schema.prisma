datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// 1. User profile
model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String?
  role                  String              @default("registered_customer") // super_admin, provider_ops, editor, dispatcher, registered_customer, provider_staff
  name                  String
  phone                 String?
  locale                String              @default("en")
  gdprMarketingConsent  Boolean             @default(false)
  twoFactorSecret       String?
  twoFactorEnabled      Boolean             @default(false)
  twoFactorMethod       String              @default("totp") // totp, email
  emailOtpCode          String?
  emailOtpExpiresAt     DateTime?
  loginCount            Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?


  providerCompanyId     String?
  providerCompany       Provider?           @relation(fields: [providerCompanyId], references: [id], onDelete: SetNull)

  bookings              Booking[]
  recurringSchedules    RecurringSchedule[]
  quotesCreated         Quote[]             @relation("OpsUserQuotes")
  reviews               Review[]
  auditLogs             AuditLog[]

  organizationId        String?
  organization          Organization?       @relation("OrgUsers", fields: [organizationId], references: [id], onDelete: SetNull)
  managedOrganizations  Organization[]      @relation("OrgAccountManager")
}

// 2. Guest Verification
model GuestEmail {
  email        String    @id
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
}

// 3. Marketplace Providers (formerly Subcontractor Partners)
model Provider {
  id                      String        @id @default(uuid())
  name                    String
  slug                    String        @unique
  contactEmail            String
  contactPhone            String
  address                 String
  legalEntityType         String        // einzelfirma, gmbh, ag, other_eu
  uidNumber               String        // Swiss UID (VAT/business ID)
  bankDetailsVerified     Boolean       @default(false)
  stripeConnectAccountId  String?
  stripeConnectStatus     String        @default("pending") // pending, active, restricted, rejected
  onboardingStatus        String        @default("applied") // applied, under_review, approved, active, suspended, terminated
  onboardingCompletedAt   DateTime?
  commissionOverrideRate  Decimal?      // Optional rate override
  criminalRecordExtractUrl String?
  insuranceDocUrl         String?
  insuranceExpiresAt      DateTime?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  teams                   ProviderTeam[]
  staff                   User[]
  documents               ProviderDocument[]
  listings                ProviderListing[]
  offers                  ProviderOffer[]
  payouts                 Payout[]
  reviewsSummary          ProviderReview[]
}

// 4. Provider Teams (formerly Partner Teams)
model ProviderTeam {
  id                String              @id @default(uuid())
  providerId        String
  provider          Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name              String
  workingHours      String              // JSON string, e.g. {"mon": ["08:00", "18:00"]}
  serviceCategories String              // JSON array or comma-separated vertical categories
  region            String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]

  @@index([providerId])
}

// 5. Service Categories
model ServiceCategory {
  slug            String            @id
  name            String
  vertical        String            // aviation, yacht, commercial, hospitality, special
  pricingModel    String            @default("instant") // instant, quote_on_request
  active          Boolean           @default(true)
  customPriceText String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  offerings    ServiceOffering[]
  bookings     Booking[]
  schedules    RecurringSchedule[]
}

// 6. Service Offerings
model ServiceOffering {
  id           String          @id @default(uuid())
  categorySlug String
  category     ServiceCategory @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  name         String
  basePriceChf Decimal
  unit         String          // per_job, per_hour, per_m2, per_foot
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categorySlug])
}

// 7. Bookings
model Booking {
  id                    String           @id @default(uuid())
  customerId            String?
  customer              User?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestEmail            String?
  guest                 GuestEmail?      @relation(fields: [guestEmail], references: [email], onDelete: SetNull)
  vertical              String
  categorySlug          String?
  category              ServiceCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  intake                String           // JSON string of form inputs
  scheduledAt           DateTime
  scheduledWindow       String
  locationAddress       String
  locationGeo           String?
  providerTeamId        String?
  providerTeam          ProviderTeam?    @relation(fields: [providerTeamId], references: [id], onDelete: SetNull)
  status                String           @default("draft") // draft, intake_submitted, quote_pending, quote_sent, quote_accepted, payment_pending, confirmed, offer_dispatched, offer_accepted, assigned, in_progress, completed, cancelled_by_customer, cancelled_by_ops, cancelled_no_provider
  totalAmountChf        Decimal
  depositAmountChf      Decimal
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  isFirstBooking        Boolean          @default(true)
  cancellationReason    String?
  balanceStripePaymentIntentId String?
  balanceAuthStatus            String?   @default("not_attempted")
  balanceAuthFailedAt          DateTime?
  balanceAuthAttempts          Int       @default(0)
  providerOfferId       String?
  providerPayoutAmountChf Decimal?
  commissionAmountChf   Decimal?
  promoCampaignId       String?
  promoCampaign         PromoCampaign?   @relation("PromoBookings", fields: [promoCampaignId], references: [id], onDelete: SetNull)
  promoDiscountChf      Decimal?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  quote                 Quote?
  payments              Payment[]
  review                Review?
  offers                ProviderOffer[]
  payouts               Payout[]
  commissionLedgers     CommissionLedger[]
  disputes              Dispute[]

  @@index([customerId])
  @@index([guestEmail])
  @@index([providerTeamId])
  @@index([promoCampaignId])
}

// 8. Booking Quotes
model Quote {
  bookingId    String    @id
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  opsUserId    String?
  opsUser      User?     @relation("OpsUserQuotes", fields: [opsUserId], references: [id], onDelete: SetNull)
  amountChf    Decimal
  validUntil   DateTime
  sentAt       DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 9. Stripe Payments
model Payment {
  id                String   @id @default(uuid())
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripeChargeId    String
  amountChf         Decimal
  status            String   @default("pending") // pending, succeeded, failed, refunded
  refundedAmountChf Decimal  @default(0.00)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([bookingId])
}

// 10. Recurring Subscriptions
model RecurringSchedule {
  id                   String          @id @default(uuid())
  customerId           String
  customer             User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categorySlug         String
  category             ServiceCategory @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  frequency            String          // weekly, bi_weekly, monthly, quarterly
  dayOfWeek            Int             // 0-6
  timeWindow           String
  stripeSubscriptionId String
  status               String          @default("active")
  nextRunAt            DateTime
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([customerId])
}

// 11. Availability Blocks
model AvailabilityBlock {
  id            String       @id @default(uuid())
  providerTeamId String
  providerTeam  ProviderTeam @relation(fields: [providerTeamId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  reason        String       @default("capacity") // capacity, vacation, holiday
  autoBlocked   Boolean      @default(false)
  bookingId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([providerTeamId])
}

// 12. Service Reviews
model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  public     Boolean  @default(false)
  customerId String?
  customer   User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 13. Audit Trails
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetTable String
  targetId    String
  before      String?  // JSON string
  after       String?  // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([targetTable, targetId])
}

// 14. GDPR Consents
model ConsentLog {
  id          String    @id @default(uuid())
  userId      String?
  email       String
  consentType String
  granted     Boolean
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?

  @@index([email])
}

// --- NEW V2 MARKETPLACE MODELS ---

// 15. Provider Applications
model ProviderApplication {
  id                  String   @id @default(uuid())
  applicantEmail      String
  applicantName       String
  companyName         String
  legalEntityType     String   // einzelfirma, gmbh, ag, other_eu
  verticalsRequested  String   // comma-separated or JSON list
  region              String
  submittedAt         DateTime @default(now())
  status              String   @default("submitted") // submitted, under_review, info_requested, approved, rejected
  reviewerUserId      String?
  decisionAt          DateTime?
  decisionNotes       String?
  applicationData     String   // JSON string of form answers
}

// 16. Provider Documents
model ProviderDocument {
  id                  String   @id @default(uuid())
  providerId          String
  provider            Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  docType             String   // insurance, criminal_record, vat_cert, certification, reference
  fileUrl             String
  expiresAt           DateTime?
  verified            Boolean  @default(false)
  verifiedByUserId    String?
  verifiedAt          DateTime?
  uploadedAt          DateTime @default(now())

  @@index([providerId])
}

// 17. Provider Listings (Capabilities)
model ProviderListing {
  id              String   @id @default(uuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categorySlug    String
  customPriceChf  Decimal? // only for quote-on-request verticals
  serviceRadiusKm Int      @default(50)
  capacityPerDay  Int      @default(3)
  leadTimeHours   Int      @default(24)
  active          Boolean  @default(true)

  @@index([providerId])
}

// 18. Provider Offers (Matching dispatch system)
model ProviderOffer {
  id              String    @id @default(uuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerId      String
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  offeredAt       DateTime  @default(now())
  expiresAt       DateTime
  response        String    @default("pending") // pending, accepted, declined, timed_out
  responseAt      DateTime?
  declineReason   String?

  @@index([bookingId])
  @@index([providerId])
}

// 19. Provider Payouts Ledger
model Payout {
  id                String    @id @default(uuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  amountChf         Decimal
  currency          String    @default("CHF")
  stripeTransferId  String?
  status            String    @default("scheduled") // scheduled, in_transit, paid, failed, reversed
  scheduledFor      DateTime
  paidAt            DateTime?
  failureReason     String?

  @@index([providerId])
  @@index([bookingId])
}

// 20. Commission Ledger
model CommissionLedger {
  id                  String   @id @default(uuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmountChf      Decimal
  commissionRate      Decimal
  commissionAmountChf Decimal
  providerPayoutChf   Decimal
  calculatedAt        DateTime @default(now())
  settledAt           DateTime?
  notes               String?

  @@index([bookingId])
}

// 21. Provider Performance reviews
model ProviderReview {
  id              String   @id @default(uuid())
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  jobsCompleted   Int
  avgRating       Decimal
  onTimePct       Decimal
  cancellationPct Decimal
  computedAt      DateTime @default(now())

  @@index([providerId])
}

// 22. Dispute management
model Dispute {
  id                    String    @id @default(uuid())
  bookingId             String
  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy              String    // customer, provider, ops
  reason                String
  description           String
  evidenceUrls          String    // Comma-separated or JSON list
  status                String    @default("open") // open, in_review, resolved, closed
  resolution            String?   // refund_full, refund_partial, redo, dismissed
  resolvedByUserId      String?
  resolvedAt            DateTime?
  refundAmountChf       Decimal?
  payoutAdjustmentChf   Decimal?

  @@index([bookingId])
}

// 23. Dynamic localized pages (for legal, privacy, terms, cookies etc.)
model Page {
  id           String            @id @default(uuid())
  key          String            @unique // e.g. "privacy", "terms", "cookies"
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations PageTranslation[]
}

model PageTranslation {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale    String   // e.g. "de", "en", "fr", "it", "rm", "es", "pt"
  slug      String   // e.g. "legal/privacy", "juridique/confidentialite"
  title     String
  content   String   // Markdown or HTML content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@unique([pageId, locale])
  @@index([pageId])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// B2B Organization Account
model Organization {
  id                  String            @id @default(uuid())
  name                String
  type                String            // "verwaltung", "restaurant_group", "hospitality", "other"
  uidVat              String?           // Swiss VAT / UID
  billingAddress      String
  billingEmail        String
  paymentTerms        String            @default("card") // "card", "invoice_net30"
  primaryContactName  String
  primaryContactPhone String?
  accountManagerId    String?           // References User (Super Admin/Ops)
  accountManager      User?             @relation("OrgAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  status              String            @default("active") // "active", "suspended"
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  properties          Property[]
  contracts           ServiceContract[]
  users               User[]            @relation("OrgUsers")
}

// Managed site under an Organization
model Property {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  address         String
  geo             String?
  type            String            // "building", "restaurant", "mixed_use", etc.
  intake          String            // JSON string containing building/venue specs (§7.6 / 7.7)
  accessInfo      String            // JSON string containing alarm/key info
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contracts       ServiceContract[]

  @@index([organizationId])
}

// Recurring B2B Agreement
model ServiceContract {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vertical        String            // "building_care", "restaurant"
  tier            String            // "common_areas", "extraction_compliance", "nightly_maintenance"
  frequency       String            // "weekly", "bi_weekly", "monthly", "custom"
  schedule        String            // JSON string: { dayOfWeek: Int, window: String }
  partnerTeamId   String?           // Nullable until assigned (matches ProviderTeam.id)
  priceChf        Decimal
  billingCadence  String            @default("monthly_invoice") // "monthly_invoice", "stripe_subscription"
  startsOn        DateTime
  endsOn          DateTime?
  status          String            @default("draft") // "draft", "active", "suspended", "expired"
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  jobs            JobOccurrence[]

  @@index([organizationId])
  @@index([propertyId])
}

// Scheduled B2B Job occurrence spawned from a ServiceContract
model JobOccurrence {
  id                String          @id @default(uuid())
  contractId        String
  contract          ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime
  partnerTeamId     String?         // Nullable until assigned
  status            String          @default("scheduled") // "scheduled", "in_progress", "completed", "disputed", "cancelled"
  completionPhotos  String?         // JSON string array of URLs (stored as JSON string)
  rating            Int?
  certificateDocId  String?         // Nullable compliance certificate reference
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([contractId])
}

// --- MARKETING & CAMPAIGNS ---

// 24. Marketing Promo Campaigns
model PromoCampaign {
  id                String       @id @default(uuid())
  name              String                              // "Marina Summer 2026", "Airport Lounge Drop"
  code              String       @unique                // "MARINA10", "SUMMER25" — URL promo code
  discountType      String                              // "percentage" | "fixed"
  discountValue     Decimal                             // 10 (= 10%) or 20.00 (= CHF 20)
  vertical          String?                             // null = all verticals, or "commercial", "yacht", etc.
  description       String?                             // Internal notes
  pamphletHeadline  String?                             // Custom headline for printed pamphlet
  pamphletSubtext   String?                             // Custom body text for pamphlet
  pamphletVerticals String?                             // JSON array of selected verticals e.g. '["aviation","yacht","home"]'
  pamphletHtml      String?                             // Custom user-edited HTML template if modified directly
  pamphletTheme     String?                             // "classic" | "modern" | "minimal" | "bespoke"
  pamphletImage     String?                             // Custom or preset hero image URL
  pamphletPalette   String?                             // "gold" | "emerald" | "navy" | "burgundy" | "monochrome"
  pamphletLocation  String?                             // e.g. "Zürich", "Geneva", "Zug", "St. Moritz"
  validFrom         DateTime     @default(now())
  validUntil        DateTime?                           // null = no expiry
  maxRedemptions    Int?                                // null = unlimited
  totalRedemptions  Int          @default(0)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  scans             PromoScan[]
  bookings          Booking[]    @relation("PromoBookings")
}

// 25. QR Scan Tracking
model PromoScan {
  id              String        @id @default(uuid())
  campaignId      String
  campaign        PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scannedAt       DateTime      @default(now())
  ipAddress       String?
  userAgent       String?
  referrer        String?

  @@index([campaignId])
  @@index([scannedAt])
}

// 26. Commercial Marketing Mining (Handelsregister / Relocations / Incorporations)
model MiningLead {
  id                    String      @id @default(uuid())
  source                String      @default("shab") // shab, zefix, manual, csv
  subRubric             String?     // HR01 (new), HR02 (relocation), HR03 (deletion)
  publicationId         String?     @unique
  publicationDate       DateTime
  canton                String      // ZH, BE, ZG, etc.
  uid                   String?     // CHE-xxx.xxx.xxx
  companyName           String
  legalForm             String?     // AG, GmbH, Einzelunternehmen, etc.
  changeType            String?     // seat, domicile, seat+domicile, incorporation
  newSeat               String?     // Municipality
  newAddress            String?     // Street, number, zip, city
  oldAddress            String?     // Previous address / seat (key for move-out cleaning)
  purpose               String?     // Official company purpose (Zweck)

  // Intelligence & Qualification
  detectedVertical      String      @default("commercial") // commercial, moveout, hospitality, special
  priorityScore         Int         @default(50) // 0 - 100
  confidence            String      @default("medium") // high, medium, low

  // CRM & Pipeline
  status                String      @default("new") // new, contacted, qualified, quoted, won, dismissed
  contactedAt           DateTime?
  contactNotes          String?
  contactPhone          String?     // Direct phone number
  contactEmail          String?     // Contact email
  contactPerson         String?     // Contact person / decision-maker name
  website               String?     // Company website
  assignedToUserId      String?
  sourceUrl             String?

  // Geocoding / Verification
  geoLatitude           Float?
  geoLongitude          Float?
  zefixVerified         Boolean     @default(false)

  // Optional link if converted to a Booking / Quote
  convertedBookingId    String?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([canton, status])
  @@index([publicationDate])
  @@index([uid])
}
